# HERTZ temporary broadcasting preset for butt
#
# Open this file with:
#   butt -c hertz.buttrc
#
# The HERTZ server entry uses type = 2 (HERTZ RTP). No password, mountpoint,
# or Icecast handshake is used. HERTZ must be running with UDP ingest on
# 127.0.0.1:5004 and Opus 48 kHz selected.

[main]
server = HERTZ
srv_ent = HERTZ
icy =
num_of_srv = 1
num_of_icy = 0
icy_ent =
song_path =
song_update = 0
log_file =
gain = 1.0
connect_at_startup = 1

[audio]
device = 0
samplerate = 48000
bitrate = 128
channel = 2
channels = 2
codec = opus
aac_overwrite_aot = 0
aac_aot = 5
resample_mode = 0
buffer_ms = 20

[record]
bitrate = 192
codec = mp3
start_rec = 0
sync_to_hour = 0
split_time = 0
filename = rec_%Y%m%d-%H%M%S.mp3
folder = .

[gui]
attach = 0
ontop = 0
lcd_auto = 0

[HERTZ]
address = 127.0.0.1
port = 5004
password =
type = 2
mount = (none)
usr = (none)
